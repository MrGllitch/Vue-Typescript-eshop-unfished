// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model BillingAddress {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  street      String
  city        String
  state       String
  zip         String
  houseNumber String
  account     Account[]
  order       Order[]
}

model DeliveryAddress {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  street      String
  city        String
  state       String
  zip         String
  houseNumber String
  account     Account[]
  order       Order[]
}

model Contact {
  id          Int           @id @default(autoincrement())
  firstName   String?
  lastName    String?
  phoneNumber String?
  account     Account[]
  tempAccount TempAccount[]
}

model Account {
  id       String @id @db.Uuid
  email    String @unique
  password String

  role       Role @default(USER)
  dAddressId Int?
  bAddressId Int?
  contactId  Int?

  dAddress     DeliveryAddress?     @relation(fields: [dAddressId], references: [id])
  bAddress     BillingAddress?      @relation(fields: [bAddressId], references: [id])
  contact      Contact?             @relation(fields: [contactId], references: [id])
  orders       Order[]
  reservations ProductReservation[]
  sessions     Session[]
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       String   @db.Uuid
  user         Account  @relation(fields: [userId], references: [id])
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TempAccount {
  id        String  @id @db.Uuid
  email     String?
  contactId Int

  contact Contact @relation(fields: [contactId], references: [id])
  orders  Order[]
}

model ProductDetails {
  id       Int       @id @default(autoincrement())
  width    Float?
  height   Float?
  depth    Float?
  weight   Float?
  products Product[]
}

model Owner {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Country {
  id         Int        @id @default(autoincrement())
  nameCz     String
  nameEn     String
  localities Locality[]
}

model Locality {
  id        Int    @id @default(autoincrement())
  nameCz    String
  nameEn    String
  countryId Int

  country  Country   @relation(fields: [countryId], references: [id])
  products Product[]
}

model Product {
  id               Int            @id @default(autoincrement())
  nameCz           String
  descriptionCz    String
  nameEn           String
  descriptionEn    String
  note             String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  visible          Boolean        @default(false)
  quantity         Int            @default(1)
  bPrice           Float
  productDetailsId Int
  ownerId          Int
  localityId       Int
  productImages    ProductImage[]
  categories       Category[]
  colors           Color[]
  prices           ProductPrice[]

  productDetails ProductDetails       @relation(fields: [productDetailsId], references: [id])
  owner          Owner                @relation(fields: [ownerId], references: [id])
  locality       Locality             @relation(fields: [localityId], references: [id])
  orderItems     OrderItem[]
  reservations   ProductReservation[]
}

model OrderItem {
  id        Int @id @default(autoincrement())
  quantity  Int
  productId Int

  product Product @relation(fields: [productId], references: [id])
  orders  Order[]
}

model Order {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  status         String
  paymentMethod  String
  shippingMethod String
  totalPrice     Float
  tempAccountId  String?  @db.Uuid
  accountId      String?  @db.Uuid
  orderItemId    Int
  dAddressId     Int
  bAddressId     Int

  dAddress    DeliveryAddress @relation(fields: [dAddressId], references: [id])
  bAddress    BillingAddress  @relation(fields: [bAddressId], references: [id])
  tempAccount TempAccount?    @relation(fields: [tempAccountId], references: [id])
  account     Account?        @relation(fields: [accountId], references: [id])
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id])
}

model ProductPrice {
  id        Int       @id @default(autoincrement())
  value     Float
  startDate DateTime  @default(now())
  endDate   DateTime?
  sale      Boolean   @default(false)
  products  Product[]
}

model Color {
  id       Int       @id @default(autoincrement())
  name     String
  color    String
  products Product[]
}

model Category {
  id       Int       @id @default(autoincrement())
  nameCz   String
  nameEn   String
  slug     String
  products Product[]
}

model ProductImage {
  id       Int       @id @default(autoincrement())
  path     String
  caption  String?
  products Product[]
}

model ProductReservation {
  id        Int      @id @default(autoincrement())
  start     DateTime
  end       DateTime
  accountId String   @db.Uuid
  productId Int

  account Account @relation(fields: [accountId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
